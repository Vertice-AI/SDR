# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_ENV=local                       # local | staging | production
APP_NAME=sdr-agent
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=troque-esta-chave    # assinatura de JWT
APP_ENCRYPTION_KEY=                 # 32 bytes base64 — criptografa segredos por tenant
PHONE_HASH_PEPPER=                  # pepper do hash de telefone usado em log
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Sao_Paulo

# ─── Banco e fila ─────────────────────────────────────────────────────────────
# Role de runtime, sem BYPASSRLS — a política de RLS por tenant é a única
# forma de acessar dados de negócio (`docs/03` §6).
DATABASE_URL=postgresql+asyncpg://sdr_app:sdr_app@localhost:5432/sdr
# Role administrativa, só para Alembic (ALTER TABLE / CREATE POLICY / GRANT).
DATABASE_ADMIN_URL=postgresql+asyncpg://sdr:sdr@localhost:5432/sdr
REDIS_URL=redis://localhost:6379/0

# ─── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5              # conversa
LLM_MODEL_FAST=claude-haiku-4-5-20251001    # classificação, extração, resumo
LLM_MAX_ITERATIONS=6
LLM_TIMEOUT_SECONDS=20

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=voyage           # voyage | openai
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ─── Transcrição de áudio ─────────────────────────────────────────────────────
TRANSCRIPTION_PROVIDER=openai       # openai | deepgram | none
DEEPGRAM_API_KEY=

# ─── Google Calendar (OAuth do app, não do cliente) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/admin/integrations/google/callback

# ─── Conversa ─────────────────────────────────────────────────────────────────
DEFAULT_DEBOUNCE_SECONDS=8
MAX_DEBOUNCE_SECONDS=30
CONVERSATION_LOCK_TTL_SECONDS=120
MAX_MESSAGES_IN_CONTEXT=20
SUMMARIZE_EVERY_N_MESSAGES=15
SLOT_RESERVATION_TTL_SECONDS=600

# ─── Observabilidade ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ─── Alertas ──────────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=                  # Slack ou webhook interno
ALERT_MIN_SEVERITY=high

# ─── Evolution API (apenas dev/homologação) ───────────────────────────────────
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=

# NOTA: credenciais de WhatsApp (Meta e Evolution) e tokens do Google Calendar
# de cada cliente NÃO ficam aqui. São armazenados criptografados no banco,
# por tenant, nas tabelas `channels` e `sellers`.
